# Required. Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. If set, the page asks for this before it will spend credit.
APP_ACCESS_KEY=

# Text model for the two research agents and the debate writer.
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash

# Persian speech. Iranian Persian is supported. Use google/gemini-3.8-flash-lite-tts to spend less.
OPENROUTER_TTS_MODEL_FA=google/gemini-3.8-flash-tts

# English speech with separate male and female voices. Cost is very small.
OPENROUTER_TTS_MODEL_EN=hexgrad/kokoro-82m

# English speech for the free option. One default timbre for both speakers.
OPENROUTER_TTS_MODEL_EN_FREE=fish-audio/s2.1-pro-free:free

APP_URL=http://localhost:3000
